{
  "version": 1,
  "rules_version": "1.1.0",
  "literal_replacements": [
    { "find": "\u2019", "replace": "'" },
    { "find": "\u2018", "replace": "'" },
    { "find": "\u201c", "replace": "\"" },
    { "find": "\u201d", "replace": "\"" },
    { "find": "\u2026", "replace": "..." },
    { "find": "\u00a0", "replace": " " },
    { "find": "\u202f", "replace": " " }
  ],
  "regex_replacements": [
    { "pattern": "(?<=\\S)[\u2013\u2014](?=\\S)", "replace": " - " },
    { "pattern": "[ \\t]*[\u2013\u2014][ \\t]*", "replace": " - " }
  ]
}
